# Configuración General
APP_NAME=AranduIA
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Capa de Inferencia IA
# Opciones: "local_rules" (offline sin dependencias), "ollama" (servidor local), "external_api"
LLM_PROVIDER=local_rules

# Configuración Ollama (si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Configuración API Externa (opcional / fallback si LLM_PROVIDER=external_api)
EXTERNAL_API_URL=https://api.groq.com/openai/v1
EXTERNAL_API_KEY=
EXTERNAL_API_MODEL=llama-3.1-8b-instant

# Privacidad y Ley N° 7593/2025
ENFORCE_DATA_MINIMIZATION=true
LOG_ANONYMOUS_METRICS=false

# Gateway de WhatsApp (opcional)
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=arandu_secret_token
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
